@model StudentScoreManagement.Models.ProjectFunding
@{ ViewData["Title"] = "編輯提撥單"; }
<h1>編輯贊助提撥合約</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" class="card p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FundingID" />
            <div class="form-group mb-3">
                <label asp-for="SponsorID" class="control-label mb-1"></label>
                <select asp-for="SponsorID" class="form-control" asp-items="ViewBag.SponsorID"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ProjectID" class="control-label mb-1"></label>
                <select asp-for="ProjectID" class="form-control" asp-items="ViewBag.ProjectID"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="FundingAmount" class="control-label mb-1"></label>
                <input asp-for="FundingAmount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="FundingAmount" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="FundingDate" class="control-label mb-1"></label>
                <input asp-for="FundingDate" class="form-control" type="date" />
                <span asp-validation-for="FundingDate" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="儲存" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>