@model StudentScoreManagement.Models.Sponsor
@{ ViewData["Title"] = "刪除贊助商"; }
<h1>註銷贊助商</h1>
<h3 class="text-danger">確定要註銷這個合作贊助商嗎？此操作將會刪除其撥款記錄。</h3>
<div class="card p-4 mb-4">
    <dl class="row">
        <dt class="col-sm-3">名稱</dt>
        <dd class="col-sm-9">@Model.SponsorName</dd>
        <dt class="col-sm-3">電子郵件</dt>
        <dd class="col-sm-9">@Model.ContactEmail</dd>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="SponsorID" />
    <input type="submit" value="確定註銷" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">取消</a>
</form>