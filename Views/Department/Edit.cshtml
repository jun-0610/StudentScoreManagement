@model StudentScoreManagement.Models.Department
@{ ViewData["Title"] = "編輯部門/科系"; }
<h1>編輯科系與部門</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" class="card p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DepartmentID" />
            <div class="form-group mb-3">
                <label asp-for="DepartmentName" class="control-label mb-1"></label>
                <input asp-for="DepartmentName" class="form-control" />
                <span asp-validation-for="DepartmentName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="OfficeLocation" class="control-label mb-1"></label>
                <input asp-for="OfficeLocation" class="form-control" />
                <span asp-validation-for="OfficeLocation" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Budget" class="control-label mb-1"></label>
                <input asp-for="Budget" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Budget" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="儲存" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>