@model StudentScoreManagement.Models.Department
@{ ViewData["Title"] = "刪除部門/科系"; }
<h1>刪除部門與科系</h1>
<h3 class="text-danger">確定要刪除此科系嗎？此操作將會刪除其關聯之資料。</h3>
<div class="card p-4 mb-4">
    <dl class="row">
        <dt class="col-sm-3">科系名稱</dt>
        <dd class="col-sm-9">@Model.DepartmentName</dd>
        <dt class="col-sm-3">辦公室</dt>
        <dd class="col-sm-9">@Model.OfficeLocation</dd>
        <dt class="col-sm-3">年度預算</dt>
        <dd class="col-sm-9">$@Model.Budget.ToString("N2")</dd>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="DepartmentID" />
    <input type="submit" value="確定刪除" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">取消</a>
</form>