@model StudentScoreManagement.Models.Department
@{ ViewData["Title"] = "部門詳細資料"; }
<h1>科系/部門詳細資料</h1>
<div class="card p-4">
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DepartmentName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DepartmentName)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OfficeLocation)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.OfficeLocation)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Budget)</dt>
        <dd class="col-sm-9">$@Model.Budget.ToString("N2")</dd>
    </dl>
</div>
<hr />
<h3>部門內教師名單</h3>
<table class="table table-hover">
    <thead>
        <tr><th>教師姓名</th><th>薪資</th><th>電子郵件</th></tr>
    </thead>
    <tbody>
@if (Model.Instructors != null && Model.Instructors.Any()) {
    foreach(var i in Model.Instructors) {
        <tr><td>@i.FullName</td><td>$@i.Salary.ToString("N2")</td><td>@i.Email</td></tr>
    }
} else {
    <tr><td colspan="3" class="text-muted text-center">尚無教師資料</td></tr>
}
    </tbody>
</table>
<hr />
<h3>部門內學生名單</h3>
<table class="table table-hover">
    <thead>
        <tr><th>學生姓名</th><th>電子郵件</th><th>入學日期</th></tr>
    </thead>
    <tbody>
@if (Model.Students != null && Model.Students.Any()) {
    foreach(var s in Model.Students) {
        <tr><td>@s.FullName</td><td>@s.Email</td><td>@s.EnrollmentDate.ToShortDateString()</td></tr>
    }
} else {
    <tr><td colspan="3" class="text-muted text-center">尚無學生資料</td></tr>
}
    </tbody>
</table>
<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.DepartmentID" class="btn btn-primary">編輯</a>
    <a asp-action="Index" class="btn btn-secondary">返回列表</a>
</div>