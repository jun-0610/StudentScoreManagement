@model IEnumerable<StudentScoreManagement.Models.Department>
@{ ViewData["Title"] = "部門/科系管理"; }
<h1>科系與部門列表</h1>
<p><a asp-action="Create" class="btn btn-primary">➕ 新增部門/科系</a></p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>部門ID</th>
            <th>科系/部門名稱</th>
            <th>辦公室位置</th>
            <th>年度預算</th>
            <th>功能</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.DepartmentID</td>
            <td>@item.DepartmentName</td>
            <td>@item.OfficeLocation</td>
            <td>$@item.Budget.ToString("N2")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DepartmentID" class="btn btn-sm btn-warning">編輯</a> |
                <a asp-action="Details" asp-route-id="@item.DepartmentID" class="btn btn-sm btn-info">詳細</a> |
                <a asp-action="Delete" asp-route-id="@item.DepartmentID" class="btn btn-sm btn-danger">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>