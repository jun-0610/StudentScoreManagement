@model StudentScoreManagement.Models.Project
@{ ViewData["Title"] = "刪除專案"; }
<h1>刪除專案</h1>
<h3 class="text-danger">確定要刪除這筆專案與其附隨的任務、成員關聯嗎？</h3>
<div class="card p-4 mb-4">
    <dl class="row">
        <dt class="col-sm-3">專案名稱</dt>
        <dd class="col-sm-9">@Model.ProjectName</dd>
        <dt class="col-sm-3">經費預算</dt>
        <dd class="col-sm-9">$@Model.Budget.ToString("N2")</dd>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="ProjectID" />
    <input type="submit" value="確定刪除" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">取消</a>
</form>