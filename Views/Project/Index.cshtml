@model IEnumerable<StudentScoreManagement.Models.Project>
@{ ViewData["Title"] = "研究專案管理"; }
<h1>學術研究專案列表 (Hierarchy Level 3)</h1>
<p><a asp-action="Create" class="btn btn-primary">➕ 新增專案</a></p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>專案ID</th>
            <th>專案名稱</th>
            <th>預算</th>
            <th>開始日期</th>
            <th>結束日期</th>
            <th>主持人/負責教師</th>
            <th>功能</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.ProjectID</td>
            <td>@item.ProjectName</td>
            <td>$@item.Budget.ToString("N2")</td>
            <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
            <td>@(item.EndDate.HasValue ? item.EndDate.Value.ToString("yyyy-MM-dd") : "進行中")</td>
            <td>@(item.LeadInstructor != null ? item.LeadInstructor.FullName : "無")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProjectID" class="btn btn-sm btn-warning">編輯</a> |
                <a asp-action="Details" asp-route-id="@item.ProjectID" class="btn btn-sm btn-info">團隊/明細</a> |
                <a asp-action="Delete" asp-route-id="@item.ProjectID" class="btn btn-sm btn-danger">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>