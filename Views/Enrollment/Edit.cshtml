@model StudentScoreManagement.Models.Enrollment
@{ ViewData["Title"] = "登記成績"; }
<h1>編輯選課紀錄與評分</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" class="card p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="EnrollmentID" />
            <div class="form-group mb-3">
                <label asp-for="StudentID" class="control-label mb-1"></label>
                <select asp-for="StudentID" class="form-control" asp-items="ViewBag.StudentID"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CourseID" class="control-label mb-1"></label>
                <select asp-for="CourseID" class="form-control" asp-items="ViewBag.CourseID"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Semester" class="control-label mb-1"></label>
                <input asp-for="Semester" class="form-control" />
                <span asp-validation-for="Semester" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Grade" class="control-label mb-1"></label>
                <input asp-for="Grade" class="form-control" type="number" step="0.01" min="0" max="100" />
                <span asp-validation-for="Grade" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="儲存" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>