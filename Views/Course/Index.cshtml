@model IEnumerable<StudentScoreManagement.Models.Course>
@{ ViewData["Title"] = "開課明細管理"; }
<h1>開課與課程列表</h1>
<p><a asp-action="Create" class="btn btn-primary">➕ 新增課程</a></p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>課程ID</th>
            <th>課程名稱</th>
            <th>學分數</th>
            <th>開設科系</th>
            <th>授課教師</th>
            <th>功能</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.CourseID</td>
            <td>@item.CourseName</td>
            <td>@item.Credits</td>
            <td>@(item.Department != null ? item.Department.DepartmentName : "無")</td>
            <td>@(item.Instructor != null ? item.Instructor.FullName : "無")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CourseID" class="btn btn-sm btn-warning">編輯</a> |
                <a asp-action="Details" asp-route-id="@item.CourseID" class="btn btn-sm btn-info">詳細</a> |
                <a asp-action="Delete" asp-route-id="@item.CourseID" class="btn btn-sm btn-danger">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>