@model StudentScoreManagement.Models.Course
@{ ViewData["Title"] = "刪除課程"; }
<h1>刪除課程</h1>
<h3 class="text-danger">確定要刪除這門課程嗎？此操作將會移除學生選課成績。</h3>
<div class="card p-4 mb-4">
    <dl class="row">
        <dt class="col-sm-3">課程名稱</dt>
        <dd class="col-sm-9">@Model.CourseName</dd>
        <dt class="col-sm-3">學分數</dt>
        <dd class="col-sm-9">@Model.Credits</dd>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="CourseID" />
    <input type="submit" value="確定刪除" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">取消</a>
</form>