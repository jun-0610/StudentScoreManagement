@model StudentScoreManagement.Models.Student
@{ ViewData["Title"] = "刪除學生"; }
<h1>刪除學生</h1>
<h3 class="text-danger">確定要刪除這名學生嗎？</h3>
<div class="card p-4 mb-4">
    <dl class="row">
        <dt class="col-sm-3">學號</dt>
        <dd class="col-sm-9">@Model.StudentID</dd>
        <dt class="col-sm-3">學生姓名</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">電子郵件</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="StudentID" />
    <input type="submit" value="確定刪除" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">取消</a>
</form>